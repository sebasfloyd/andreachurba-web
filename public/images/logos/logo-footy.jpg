    margin: 0 0 1em 0;
    padding: 0 0 0 1em; /* make space for li's :before */
    list-style: none;
}
.bullet li {
    position: relative;
    padding-left: 0.4em; /* text distance to icon */
}
.bullet li:before {
        font-family: FontAwesome;
        content: "\f00c";
        position: absolute;
        left: -1em; /* same as ul padding-left */
        top: -0.3em; /* depends on character, maybe use padding-top instead */
